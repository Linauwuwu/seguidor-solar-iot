# Copia este archivo como plc.env (en la misma carpeta que plc_mqtt.py) y rellénalo.
# plc.env NO se sube a GitHub (contiene contraseñas y tokens).

# --- PLC Siemens S7-1200 ---
PLC_IP=10.41.32.1
PLC_RACK=0
PLC_SLOT=1
PLC_DB=1

# Escrituras al PLC: false = solo lectura (valor seguro por defecto).
# Con false la ESP32 queda bloqueada, porque el PLC no recibe heartbeat.
# Cámbialo a true SOLO con autorización y después de cargar el cambio SCL de LEEME_PLC.md.
PLC_ESCRITURA=false
# Byte del HeartbeatRpi (Int) en DB1. Confírmalo en TIA Portal (columna Offset del DB1).
PLC_BYTE_HEARTBEAT=12
# true = escribe los ángulos de la ESP32 en DB1.DBD2 / DB1.DBD6 (requiere también PLC_ESCRITURA=true)
PLC_ESCRIBIR_ANGULOS=false

# Tiempos (segundos)
PLC_CICLO=1
PUBLICAR_CADA=5

# --- MQTT / Mosquitto (el broker del PC donde corre Docker) ---
MQTT_BROKER_HOST=10.216.203.203
MQTT_BROKER_PORT=1883
MQTT_USERNAME=ecs
MQTT_PASSWORD=pon-aqui-la-clave-mqtt
MQTT_TOPIC_PREFIX=ecs

# --- Tokens de Django (Dispositivos > ver dispositivo) ---
# Lo muestra:  docker compose exec web python manage.py preparar_plc
PLC_TOKEN=
# Token del dispositivo "raspberry" (opcional: mantiene la Raspberry en línea en el dashboard)
RASPBERRY_TOKEN=

# --- Topics (no cambiar salvo que cambie el firmware) ---
TOPIC_PERMISO=lina/plc/permiso
TOPIC_ESTADO=solartrack/plc/estado
